## Common Usage Patterns

### 1. Basic Card Review Flow

```swift
// Initialize FSRS with default parameters
let fsrs = FSRS(parameters: FSRSParameters())

// Create a new card
let card = FSRSDefaults().createEmptyCard()

// Preview all possible outcomes
let preview = fsrs.repeat(card: card, now: Date())

// User rates the card as "Good"
let result = try fsrs.next(card: card, now: Date(), grade: .good)

// Use the updated card for next review
let updatedCard = result.card
```

### 2. Custom Parameters

```swift
let params = FSRSParameters(
    requestRetention: 0.85,      // 85% target retention
    maximumInterval: 365,        // Max 1 year between reviews
    enableFuzz: true,            // Add randomness
    enableShortTerm: true        // Enable short-term scheduling
)
let fsrs = FSRS(parameters: params)
```

### 3. Check Retrievability

```swift
let (percentage, value) = fsrs.getRetrievability(card: card, now: Date())
// percentage: "78.50%"
// value: 0.785
```

### 4. Rollback a Review

```swift
let preview = fsrs.repeat(card: card, now: Date())
let hardResult = preview.recordLog[.hard]!
let previousCard = try fsrs.rollback(card: hardResult.card, log: hardResult.log)
```

### 5. Forget a Card

```swift
let forgetResult = fsrs.forget(
    card: card,
    now: Date(),
    resetCount: true  // Reset review count
)
let resetCard = forgetResult.card  // Card is now in .new state
```

